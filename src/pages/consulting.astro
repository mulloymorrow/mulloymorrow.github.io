---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ConsultingVisual from '../components/ConsultingVisual.astro';

const title = 'Consulting | Mulloy Morrow';
const description = 'Paid advisory, talks, and webinars for leaders facing AI problems: scaling product velocity, managing risk in front of customers, elevating teams to judgment over grunt work, and knowing whether personalization is moving the business. Book a time that works for you.';
const canonicalUrl = new URL('/consulting/', Astro.site).toString();

const bookingPageUrl = 'https://calendar.app.google/Tak6NqBNFPbW1v3u8';
const bookingEmbedUrl = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ2Vj_aiZs3dnsGq4hdKKHSpRMRApWWQPDsgop3pBXqUvJyjxx9M8AwGKM3r-G84Hz7o5v0AlP0r?gv=true';

const offerings = [
  {
    title: 'Scaling product velocity without growing headcount linearly',
    format: 'Talk or workshop',
    visual: 'agents',
    problem: 'You need more product shipped, but hiring in lockstep with the roadmap is slow, expensive, and does not scale. Work still piles up across engineering, legal, and QA.',
    help: 'I show how to design multi-agent development systems that move work from design to production, so a small team can increase throughput without a matching increase in headcount.',
    proof: 'At Trellis Health I built a multi-agent development system in which persona agents with distinct contexts move work through shared engineering, legal, and visual QA registries, from design to production.',
  },
  {
    title: 'Managing risk when you put generative AI in front of customers',
    format: 'Talk or webinar',
    visual: 'safety',
    problem: 'Putting generative AI in front of customers is a business risk, especially in health and other regulated settings. One bad answer, a privacy miss, or the wrong person seeing the wrong data can erode trust and create liability.',
    help: 'I work with teams on the safety, access, and compliance practices needed to ship customer-facing AI with a clear risk posture.',
    proof: 'At Trellis Health I am designing a five-layer generative AI safety stack and architecting a HIPAA-compliant agentic health assistant with role-based access for parents, co-guardians, and teens, building on production work in HIPAA- and HITECH-compliant legal-tech systems.',
  },
  {
    title: 'Elevating your people to judgment, not grunt work',
    format: 'Talk or workshop',
    visual: 'hitl',
    problem: 'Too much of your team\'s time goes to technical grunt work — reviewing documents, moving tickets, repeating routine analysis — while the judgment that actually changes outcomes gets crowded out.',
    help: 'I help you design human-in-the-loop systems where AI handles the rote work and people own the critical decisions.',
    proof: 'At a legal-tech joint venture, production agentic systems analyzed legal, environmental, and medical documents for veterans\' claims and accelerated $24M in settlements in 6 months, in a HIPAA- and HITECH-compliant environment.',
  },
  {
    title: 'Knowing whether AI and personalization are actually moving the business',
    format: 'Talk or workshop',
    visual: 'spotify',
    problem: 'Teams ship models and personalization features, then struggle to prove they changed customer behavior or the P&L. Vanity metrics make it hard to decide what to double down on — and what to stop.',
    help: 'I work with leaders on causal metrics and experimentation so AI and personalization investments can be judged by long-term business impact, not just short-term engagement.',
    proof: 'At Spotify I created the User-LTV metric, adopted company-wide as the north star for long-term causal impact (Investor Day 2022). The Home personalization work drove a $10M/month lift in user margins, a 26% boost in discovery, and a $4M/year cost cut.',
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <div class="consulting-page">
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      <span class="breadcrumb__current">Consulting</span>
    </nav>

    <header class="consulting__header container">
      <p class="consulting__label">Consulting</p>
      <h1 class="consulting__title">Talks, webinars, and paid advisory</h1>
      <p class="consulting__lede">
        I work with founders, executives, and product and engineering leaders on the problems AI creates for the business: shipping faster without growing headcount in lockstep, managing risk when models face customers, freeing people for judgment instead of grunt work, and knowing whether the investment is actually paying off. Book a talk, webinar, or advisory session below.
      </p>
    </header>

    <section class="consulting__offerings container" aria-labelledby="offerings-heading">
      <h2 id="offerings-heading" class="consulting__section-title">Problems I help with</h2>
      <ul class="offerings">
        {offerings.map((item) => (
          <li class="offering">
            <div class="offering__meta">
              <h3 class="offering__title">{item.title}</h3>
              <p class="offering__format">{item.format}</p>
            </div>
            <div class="offering__copy">
              <p class="offering__problem">{item.problem}</p>
              <p class="offering__help">{item.help}</p>
              <p class="offering__proof">
                <span class="offering__proof-label">From my work.</span> {item.proof}
              </p>
            </div>
            <ConsultingVisual kind={item.visual} />
          </li>
        ))}
      </ul>
    </section>

    <section class="consulting__booking container" id="book" aria-labelledby="booking-heading">
      <h2 id="booking-heading" class="consulting__section-title">Book a time</h2>
      <p class="consulting__booking-lede">
        Choose a time that works for you. If the calendar does not load,{' '}
        <a href={bookingPageUrl} target="_blank" rel="noopener noreferrer">open the booking page</a>.
      </p>
      <div class="consulting__calendar">
        <iframe
          src={bookingEmbedUrl}
          title="Book a consulting appointment with Mulloy Morrow"
          loading="lazy"
        ></iframe>
      </div>
    </section>
  </div>
  <Footer />
</Layout>

<style>
  .consulting-page {
    min-height: 100vh;
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .breadcrumb {
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb__separator {
    margin: 0 var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb__current {
    color: var(--color-text-primary);
  }

  .consulting__header {
    text-align: center;
    padding: var(--space-12) 0 var(--space-8);
    max-width: 760px;
    margin: 0 auto;
  }

  .consulting__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-3);
  }

  .consulting__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    margin: 0 0 var(--space-5);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .consulting__lede {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .consulting__offerings {
    max-width: 960px;
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .consulting__booking {
    max-width: 800px;
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .consulting__section-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-6);
  }

  .offerings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .offering {
    display: grid;
    grid-template-columns: 1fr minmax(220px, 46%);
    grid-template-areas:
      "meta visual"
      "copy visual";
    column-gap: var(--space-5);
    row-gap: var(--space-3);
    align-items: center;
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .offering__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    align-self: end;
  }

  .offering__title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .offering__format {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }

  .offering__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: start;
    min-width: 0;
  }

  .offering__problem,
  .offering__help,
  .offering__proof {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .offering__problem {
    color: var(--color-text-primary);
  }

  .offering__proof-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-right: 0.25rem;
  }

  .offering :global(.consulting-visual) {
    grid-area: visual;
  }

  .consulting__booking-lede {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-6);
  }

  .consulting__booking-lede a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .consulting__booking-lede a:hover {
    border-color: var(--color-accent);
  }

  .consulting__calendar {
    background: #fff;
    color: #1f2937;
    color-scheme: light;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .consulting__calendar iframe {
    width: 100%;
    height: 720px;
    border: 0;
    display: block;
    background: #fff;
    color-scheme: light;
    filter: none;
    opacity: 1;
    mix-blend-mode: normal;
  }

  @media (max-width: 768px) {
    .offering {
      grid-template-columns: 1fr;
      grid-template-areas:
        "meta"
        "visual"
        "copy";
      align-items: stretch;
    }

    .offering__meta {
      align-self: start;
    }

    .consulting__header {
      padding: var(--space-8) 0 var(--space-6);
    }

    .consulting__calendar {
      padding: var(--space-2);
    }

    .consulting__calendar iframe {
      height: 960px;
    }
  }
</style>
