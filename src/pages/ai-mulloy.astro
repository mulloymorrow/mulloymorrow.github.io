---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const title = "Chat with AI-Mulloy | Mulloy Morrow";
const description = "Have a conversation with my AI surrogate. Ask about my experience, projects, or anything else.";
---

<Layout title={title} description={description}>
  <main class="ai-mulloy-page">
    <div class="ai-mulloy__background">
      <div class="ai-mulloy__blob ai-mulloy__blob--1"></div>
      <div class="ai-mulloy__blob ai-mulloy__blob--2"></div>
      <div class="ai-mulloy__pattern"></div>
    </div>
    
    <div class="container">
      <nav class="ai-mulloy__nav">
        <a href="/" class="ai-mulloy__back">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Home</span>
        </a>
      </nav>
      
      <header class="ai-mulloy__header">
        <div class="ai-mulloy__badge">AI Surrogate</div>
        <h1 class="ai-mulloy__title">Chat with AI-Mulloy</h1>
        <p class="ai-mulloy__subtitle">
          Have a conversation with my AI surrogate. Ask about my experience building ML systems, 
          my philosophy on human-centered AI, or explore potential collaborations.
        </p>
      </header>
      
      <div class="ai-mulloy__embed-container">
        <div class="ai-mulloy__embed-wrapper">
          <iframe 
            id="ai-mulloy-iframe"
            src="https://connectioncompanion.com/embed/661ce076-81c5-416d-916a-de486c2ca6a4"
            class="ai-mulloy__iframe"
            allow="clipboard-read; clipboard-write"
            title="Chat with AI-Mulloy"
            loading="lazy"
          ></iframe>
        </div>
      </div>
      
      <section class="ai-mulloy__info">
        <h2>What is ai-Mulloy?</h2>
        <p class="ai-mulloy__info-intro">
          ai-Mulloy is an AI surrogate—a conversational representation of Mulloy trained on his background, 
          expertise, and perspectives. Click any topic below to start a conversation.
        </p>
        <div class="ai-mulloy__topics">
          <button class="ai-mulloy__topic" data-prompt="Tell me about Mulloy's background. How did he get into AI and machine learning?">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
            <h3>Background & Journey</h3>
            <p>From engineering physics at UCSD to leading ML teams at Spotify—explore Mulloy's path into AI.</p>
            <span class="ai-mulloy__topic-cta">Ask about this →</span>
          </button>
          <button class="ai-mulloy__topic" data-prompt="What are Mulloy's areas of technical expertise? What ML systems has he built?">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="18" rx="1"/>
              <rect x="14" y="3" width="7" height="18" rx="1"/>
            </svg>
            <h3>Technical Expertise</h3>
            <p>Recommendation systems, two-tower models, transformers, User-LTV, and ML infrastructure at scale.</p>
            <span class="ai-mulloy__topic-cta">Ask about this →</span>
          </button>
          <button class="ai-mulloy__topic" data-prompt="What is Mulloy's philosophy on AI? What does he believe about human-centered AI?">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 16v-4M12 8h.01"/>
            </svg>
            <h3>Philosophy & Values</h3>
            <p>Human-centered AI, augmenting rather than replacing human judgment, and building technology that matters.</p>
            <span class="ai-mulloy__topic-cta">Ask about this →</span>
          </button>
          <button class="ai-mulloy__topic" data-prompt="What is Mulloy passionate about? What drives him in his work?">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            </svg>
            <h3>Passions & Interests</h3>
            <p>Deep connections, creative technology, music discovery, and building products that help people thrive.</p>
            <span class="ai-mulloy__topic-cta">Ask about this →</span>
          </button>
          <button class="ai-mulloy__topic" data-prompt="What is Connection Companion? What is Mulloy building now?">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2"/>
            </svg>
            <h3>Current Work</h3>
            <p>Connection Companion—an agentic-AI platform focused on augmenting real-world human connection.</p>
            <span class="ai-mulloy__topic-cta">Ask about this →</span>
          </button>
          <button class="ai-mulloy__topic" data-prompt="How can I collaborate with Mulloy? What kinds of projects is he interested in?">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <h3>Collaboration</h3>
            <p>AI/ML consulting, technical leadership, product strategy, and building human-centered AI systems.</p>
            <span class="ai-mulloy__topic-cta">Ask about this →</span>
          </button>
        </div>
      </section>
      
      <section class="ai-mulloy__cta">
        <div class="ai-mulloy__cta-content">
          <h2>Create Your Own AI Surrogate</h2>
          <p>
            Want your own ai-You? Connection Companion lets you create a personalized AI surrogate 
            that represents you—trained on your background, expertise, and perspectives.
          </p>
          <a href="https://connectioncompanion.com/beta" target="_blank" rel="noopener noreferrer" class="ai-mulloy__cta-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
            Join the Private Beta
          </a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .ai-mulloy-page {
    min-height: 100vh;
    position: relative;
    padding: var(--space-8) 0 var(--space-16);
  }
  
  .ai-mulloy__background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  
  .ai-mulloy__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }
  
  .ai-mulloy__blob--1 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, var(--color-accent-glow) 0%, rgba(96, 165, 250, 0.2) 100%);
    top: 10%;
    right: -10%;
    animation: float-slow 25s ease-in-out infinite;
  }
  
  .ai-mulloy__blob--2 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, rgba(69, 123, 157, 0.2) 0%, var(--color-accent-glow) 100%);
    bottom: 20%;
    left: -10%;
    animation: float-slow 30s ease-in-out infinite reverse;
  }
  
  @keyframes float-slow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.05); }
    66% { transform: translate(-20px, 30px) scale(0.95); }
  }
  
  .ai-mulloy__pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, var(--color-border) 1px, transparent 0);
    background-size: 50px 50px;
    opacity: 0.25;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);
  }
  
  .container {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  
  .ai-mulloy__nav {
    margin-bottom: var(--space-8);
  }
  
  .ai-mulloy__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }
  
  .ai-mulloy__back:hover {
    color: var(--color-accent);
  }
  
  .ai-mulloy__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }
  
  .ai-mulloy__badge {
    display: inline-block;
    background: var(--color-accent-glow);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }
  
  .ai-mulloy__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, #f8fafc 0%, #94a3b8 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .ai-mulloy__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .ai-mulloy__embed-container {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-12);
  }
  
  .ai-mulloy__embed-wrapper {
    position: relative;
    width: 100%;
    min-height: 600px;
    background: linear-gradient(135deg, var(--color-bg-elevated) 0%, var(--color-bg-surface) 100%);
  }
  
  .ai-mulloy__iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  
  .ai-mulloy__info {
    text-align: center;
  }
  
  .ai-mulloy__info h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }
  
  .ai-mulloy__info-intro {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--space-8);
    line-height: 1.6;
  }
  
  .ai-mulloy__topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-6);
  }
  
  .ai-mulloy__topic {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-align: left;
    transition: all var(--transition-base);
    cursor: pointer;
    font-family: inherit;
    width: 100%;
  }
  
  .ai-mulloy__topic:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--color-accent-glow);
  }
  
  .ai-mulloy__topic:hover .ai-mulloy__topic-cta {
    color: var(--color-accent);
  }
  
  .ai-mulloy__topic svg {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  
  .ai-mulloy__topic h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }
  
  .ai-mulloy__topic p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }
  
  .ai-mulloy__topic-cta {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color var(--transition-base);
  }
  
  /* CTA Section */
  .ai-mulloy__cta {
    margin-top: var(--space-16);
    text-align: center;
  }
  
  .ai-mulloy__cta-content {
    background: linear-gradient(135deg, var(--color-bg-surface) 0%, var(--color-bg-elevated) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-10) var(--space-8);
    position: relative;
    overflow: hidden;
  }
  
  .ai-mulloy__cta-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }
  
  .ai-mulloy__cta h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .ai-mulloy__cta p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 500px;
    margin: 0 auto var(--space-6);
    line-height: 1.6;
  }
  
  .ai-mulloy__cta-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-cool));
    color: var(--color-bg-primary);
    font-weight: 600;
    font-size: var(--text-base);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    text-decoration: none;
  }
  
  .ai-mulloy__cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--color-accent-glow);
  }
  
  @media (max-width: 768px) {
    .ai-mulloy-page {
      padding: var(--space-4) 0 var(--space-12);
    }
    
    .ai-mulloy__embed-wrapper {
      min-height: 500px;
    }
    
    .ai-mulloy__topics {
      grid-template-columns: 1fr;
    }
    
    .ai-mulloy__cta-content {
      padding: var(--space-8) var(--space-6);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const iframe = document.getElementById('ai-mulloy-iframe') as HTMLIFrameElement;
    const topicButtons = document.querySelectorAll('.ai-mulloy__topic[data-prompt]');
    
    topicButtons.forEach(button => {
      button.addEventListener('click', () => {
        const prompt = button.getAttribute('data-prompt');
        if (prompt && iframe && iframe.contentWindow) {
          // Send message to iframe to populate and submit the prompt
          iframe.contentWindow.postMessage({
            type: 'setPrompt',
            prompt: prompt
          }, 'https://connectioncompanion.com');
          
          // Scroll to the iframe
          iframe.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  });
</script>
