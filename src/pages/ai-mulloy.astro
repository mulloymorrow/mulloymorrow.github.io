---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const title = "Chat with AI-Mulloy | Mulloy Morrow";
const description = "Have a conversation with my AI surrogate. Ask about my experience, projects, or anything else.";
---

<Layout title={title} description={description}>
  <main class="ai-mulloy-page">
    <div class="ai-mulloy__background">
      <div class="ai-mulloy__blob ai-mulloy__blob--1"></div>
      <div class="ai-mulloy__blob ai-mulloy__blob--2"></div>
      <div class="ai-mulloy__pattern"></div>
    </div>
    
    <div class="container">
      <nav class="ai-mulloy__nav">
        <a href="/" class="ai-mulloy__back">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Home</span>
        </a>
      </nav>
      
      <header class="ai-mulloy__header">
        <div class="ai-mulloy__badge">AI Surrogate</div>
        <h1 class="ai-mulloy__title">Chat with AI-Mulloy</h1>
        <p class="ai-mulloy__subtitle">
          Have a conversation with my AI surrogate. Ask about my experience building ML systems, 
          my philosophy on human-centered AI, or explore potential collaborations.
        </p>
      </header>
      
      <div class="ai-mulloy__embed-container">
        <div class="ai-mulloy__embed-wrapper">
          <iframe 
            src="https://connectioncompanion.com/embed/661ce076-81c5-416d-916a-de486c2ca6a4"
            class="ai-mulloy__iframe"
            allow="clipboard-read; clipboard-write"
            title="Chat with AI-Mulloy"
            loading="lazy"
          ></iframe>
        </div>
        <p class="ai-mulloy__hint">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4M12 8h.01"/>
          </svg>
          Powered by ConnectionCompanion.com
        </p>
      </div>
      
      <section class="ai-mulloy__info">
        <h2>What can AI-Mulloy help with?</h2>
        <div class="ai-mulloy__topics">
          <div class="ai-mulloy__topic">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
            <h3>My Background</h3>
            <p>Learn about my journey from engineering physics to leading ML teams at Spotify and beyond.</p>
          </div>
          <div class="ai-mulloy__topic">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="18" rx="1"/>
              <rect x="14" y="3" width="7" height="18" rx="1"/>
            </svg>
            <h3>Technical Expertise</h3>
            <p>Dive into recommendation systems, two-tower models, transformers, and ML infrastructure.</p>
          </div>
          <div class="ai-mulloy__topic">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <h3>Collaboration</h3>
            <p>Explore how we might work together on AI/ML projects or consulting engagements.</p>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .ai-mulloy-page {
    min-height: 100vh;
    position: relative;
    padding: var(--space-8) 0 var(--space-16);
  }
  
  .ai-mulloy__background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  
  .ai-mulloy__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }
  
  .ai-mulloy__blob--1 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, var(--color-accent-glow) 0%, rgba(96, 165, 250, 0.2) 100%);
    top: 10%;
    right: -10%;
    animation: float-slow 25s ease-in-out infinite;
  }
  
  .ai-mulloy__blob--2 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, rgba(69, 123, 157, 0.2) 0%, var(--color-accent-glow) 100%);
    bottom: 20%;
    left: -10%;
    animation: float-slow 30s ease-in-out infinite reverse;
  }
  
  @keyframes float-slow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.05); }
    66% { transform: translate(-20px, 30px) scale(0.95); }
  }
  
  .ai-mulloy__pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, var(--color-border) 1px, transparent 0);
    background-size: 50px 50px;
    opacity: 0.25;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);
  }
  
  .container {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  
  .ai-mulloy__nav {
    margin-bottom: var(--space-8);
  }
  
  .ai-mulloy__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }
  
  .ai-mulloy__back:hover {
    color: var(--color-accent);
  }
  
  .ai-mulloy__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }
  
  .ai-mulloy__badge {
    display: inline-block;
    background: var(--color-accent-glow);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }
  
  .ai-mulloy__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, #f8fafc 0%, #94a3b8 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .ai-mulloy__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .ai-mulloy__embed-container {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-12);
  }
  
  .ai-mulloy__embed-wrapper {
    position: relative;
    width: 100%;
    min-height: 600px;
    background: linear-gradient(135deg, var(--color-bg-elevated) 0%, var(--color-bg-surface) 100%);
  }
  
  .ai-mulloy__iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  
  .ai-mulloy__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }
  
  .ai-mulloy__hint svg {
    opacity: 0.7;
  }
  
  .ai-mulloy__info {
    text-align: center;
  }
  
  .ai-mulloy__info h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-8);
    color: var(--color-text-primary);
  }
  
  .ai-mulloy__topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-6);
  }
  
  .ai-mulloy__topic {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-align: left;
    transition: all var(--transition-base);
  }
  
  .ai-mulloy__topic:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  
  .ai-mulloy__topic svg {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  
  .ai-mulloy__topic h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }
  
  .ai-mulloy__topic p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  
  @media (max-width: 768px) {
    .ai-mulloy-page {
      padding: var(--space-4) 0 var(--space-12);
    }
    
    .ai-mulloy__embed-wrapper {
      min-height: 500px;
    }
    
    .ai-mulloy__topics {
      grid-template-columns: 1fr;
    }
  }
</style>
