---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import ScrollVideo from '../../components/ScrollVideo.svelte';
import PingPongVideo from '../../components/PingPongVideo.svelte';

const title = "Blog | Mulloy Morrow";
const description = "Thoughts on AI, machine learning, human-centered technology, and building the future.";
const canonicalUrl = "https://code.mulloymorrow.com/blog";

// Get the philosophy page
const philosophyPage = await getEntry('pages', 'philosophy');

// Get all non-draft posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => 
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Create a combined list with philosophy page and case studies included
type ContentItem = {
  type: 'blog' | 'page' | 'case-study';
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  tags?: string[];
};

const allContent: ContentItem[] = [
  // Add Spotify case study presentation
  {
    type: 'case-study' as const,
    title: "Reinventing Spotify's Discovery",
    description: "AI Leadership Case Study: How I led the transformation of Spotify's music discovery systems using machine learning.",
    slug: '/work/spotify-presentation',
    publishedAt: new Date('2026-01-19'),
    tags: ['Case Study', 'AI/ML', 'Personalization'],
  },
  // Add philosophy page
  ...(philosophyPage ? [{
    type: 'page' as const,
    title: philosophyPage.data.title,
    description: philosophyPage.data.description,
    slug: 'philosophy',
    publishedAt: philosophyPage.data.publishedAt,
    tags: ['Philosophy', 'Human-Centered AI', 'Leadership'],
  }] : []),
  // Add blog posts
  ...sortedPosts.map(post => ({
    type: 'blog' as const,
    title: post.data.title,
    description: post.data.description,
    slug: post.slug,
    publishedAt: post.data.publishedAt,
    tags: post.data.tags,
  }))
];

// Sort all content by date
const sortedContent = allContent.sort((a, b) => 
  b.publishedAt.getTime() - a.publishedAt.getTime()
);

// Group by year
const contentByYear = sortedContent.reduce((acc, item) => {
  const year = item.publishedAt.getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(item);
  return acc;
}, {} as Record<number, ContentItem[]>);

// Sort years descending
const years = Object.keys(contentByYear).map(Number).sort((a, b) => b - a);

// JSON-LD Blog Schema
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Mulloy Morrow's Blog",
  "description": description,
  "url": canonicalUrl,
  "author": {
    "@type": "Person",
    "name": "Mulloy Morrow",
    "url": "https://code.mulloymorrow.com"
  },
  "blogPost": sortedContent.slice(0, 10).map(item => ({
    "@type": "BlogPosting",
    "headline": item.title,
    "description": item.description,
    "datePublished": item.publishedAt.toISOString(),
    "url": item.type === 'blog' 
      ? `https://code.mulloymorrow.com/blog/${item.slug}/`
      : item.type === 'page'
        ? `https://code.mulloymorrow.com/${item.slug}/`
        : `https://code.mulloymorrow.com${item.slug}/`
  }))
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head" />
  
  <div class="blog-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      <span class="breadcrumb__current">Blog</span>
    </nav>

    <header class="blog__header container">
      <h1 class="blog__title animate-on-scroll">Blog</h1>
      <p class="blog__subtitle animate-on-scroll delay-1">
        Thoughts on AI, machine learning, human-centered technology, and building the future.
      </p>
      <a href="/blog/rss.xml" class="blog__rss animate-on-scroll delay-2" aria-label="RSS Feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
        </svg>
        <span>Subscribe via RSS</span>
      </a>
    </header>

    <!-- Scroll-controlled video -->
    <section class="blog__video container animate-on-scroll delay-3">
      <ScrollVideo client:load src="/video/pika-video.mp4" />
    </section>

    <main class="blog__content container">
      {/* Content by Year */}
      {sortedContent.length === 0 ? (
        <div class="blog__empty animate-on-scroll">
          <p>No posts yet. Check back soon!</p>
        </div>
      ) : (
        years.map(year => (
          <section class="blog__year-group animate-on-scroll">
            <h2 class="blog__year-heading">{year}</h2>
            <div class="blog__posts">
              {contentByYear[year].map(item => (
                <BlogPostCard
                  title={item.title}
                  description={item.description}
                  slug={item.type === 'blog' ? item.slug : (item.type === 'page' ? `/${item.slug}` : item.slug)}
                  publishedAt={item.publishedAt}
                  tags={item.tags}
                  isExternal={item.type === 'page' || item.type === 'case-study'}
                />
              ))}
            </div>
          </section>
        ))
      )}
    </main>
  </div>
  <Footer>
    <a href="https://pika.art/" target="_blank" rel="noopener noreferrer" class="portrait-video-link" slot="social-extra" title="Made with Pika">
      <PingPongVideo client:load src="/video/portrait_drawing.mp4" className="portrait-video" />
    </a>
  </Footer>
</Layout>

<style>
  .blog-page {
    min-height: 100vh;
    padding-top: var(--space-8);
  }

  .breadcrumb {
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb__separator {
    margin: 0 var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb__current {
    color: var(--color-text-primary);
  }

  .blog__header {
    text-align: center;
    padding: var(--space-16) 0 var(--space-12);
  }

  .blog__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--space-6);
  }

  .blog__rss {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .blog__rss:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .blog__video {
    max-width: var(--content-width);
    padding-bottom: var(--space-12);
  }

  .blog__content {
    max-width: var(--content-width);
    padding-bottom: var(--space-24);
  }

  .blog__year-group {
    margin-bottom: var(--space-12);
  }

  .blog__year-heading {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }

  .blog__posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .blog__empty {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .blog__header {
      padding: var(--space-12) 0 var(--space-8);
    }
  }

  /* Portrait video in footer - same size as social icons */
  .portrait-video-link {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .portrait-video-link:hover {
    transform: translateY(-2px);
  }
</style>
