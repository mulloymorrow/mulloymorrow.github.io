---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import ScrollVideo from '../../components/ScrollVideo.svelte';
import PingPongVideo from '../../components/PingPongVideo.svelte';

const title = "Blog | Mulloy Morrow";
const description = "Thoughts on AI, machine learning, human-centered technology, and building the future.";
const canonicalUrl = "https://code.mulloymorrow.com/blog";

// Get the philosophy page as a featured item
const philosophyPage = await getEntry('pages', 'philosophy');

// Get all non-draft posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => 
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Group posts by year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = post.data.publishedAt.getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof sortedPosts>);

// Sort years descending
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);

// JSON-LD Blog Schema
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Mulloy Morrow's Blog",
  "description": description,
  "url": canonicalUrl,
  "author": {
    "@type": "Person",
    "name": "Mulloy Morrow",
    "url": "https://code.mulloymorrow.com"
  },
  "blogPost": sortedPosts.slice(0, 10).map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.publishedAt.toISOString(),
    "url": `https://code.mulloymorrow.com/blog/${post.slug}/`
  }))
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head" />
  
  <div class="blog-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      <span class="breadcrumb__current">Blog</span>
    </nav>

    <header class="blog__header container">
      <h1 class="blog__title animate-on-scroll">Blog</h1>
      <p class="blog__subtitle animate-on-scroll delay-1">
        Thoughts on AI, machine learning, human-centered technology, and building the future.
      </p>
      <a href="/blog/rss.xml" class="blog__rss animate-on-scroll delay-2" aria-label="RSS Feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
        </svg>
        <span>Subscribe via RSS</span>
      </a>
    </header>

    <!-- Scroll-controlled video -->
    <section class="blog__video container animate-on-scroll delay-3">
      <ScrollVideo client:load src="/video/pika-video.mp4" />
    </section>

    <main class="blog__content container">
      {/* Featured: Philosophy Page */}
      {philosophyPage && (
        <section class="blog__featured animate-on-scroll">
          <span class="blog__featured-label">Featured</span>
          <article class="featured-card">
            <a href="/philosophy" class="featured-card__link">
              <div class="featured-card__content">
                <h2 class="featured-card__title">{philosophyPage.data.title}</h2>
                <p class="featured-card__description">{philosophyPage.data.description}</p>
                <time class="featured-card__date" datetime={philosophyPage.data.publishedAt.toISOString()}>
                  {philosophyPage.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <div class="featured-card__arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </div>
            </a>
          </article>
        </section>
      )}

      {/* Blog Posts by Year */}
      {sortedPosts.length === 0 ? (
        <div class="blog__empty animate-on-scroll">
          <p>No posts yet. Check back soon!</p>
        </div>
      ) : (
        years.map(year => (
          <section class="blog__year-group animate-on-scroll">
            <h2 class="blog__year-heading">{year}</h2>
            <div class="blog__posts">
              {postsByYear[year].map(post => (
                <BlogPostCard
                  title={post.data.title}
                  description={post.data.description}
                  slug={post.slug}
                  publishedAt={post.data.publishedAt}
                  tags={post.data.tags}
                />
              ))}
            </div>
          </section>
        ))
      )}
    </main>
  </div>
  <Footer>
    <a href="https://pika.art/" target="_blank" rel="noopener noreferrer" class="portrait-video-link" slot="social-extra" title="Made with Pika">
      <PingPongVideo client:load src="/video/portrait_drawing.mp4" className="portrait-video" />
    </a>
  </Footer>
</Layout>

<style>
  .blog-page {
    min-height: 100vh;
    padding-top: var(--space-8);
  }

  .breadcrumb {
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb__separator {
    margin: 0 var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb__current {
    color: var(--color-text-primary);
  }

  .blog__header {
    text-align: center;
    padding: var(--space-16) 0 var(--space-12);
  }

  .blog__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--space-6);
  }

  .blog__rss {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .blog__rss:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .blog__video {
    max-width: var(--content-width);
    padding-bottom: var(--space-12);
  }

  .blog__content {
    max-width: var(--content-width);
    padding-bottom: var(--space-24);
  }

  .blog__year-group {
    margin-bottom: var(--space-12);
  }

  .blog__year-heading {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }

  .blog__posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .blog__empty {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-muted);
  }

  /* Featured Section */
  .blog__featured {
    margin-bottom: var(--space-12);
  }

  .blog__featured-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: var(--color-accent-glow);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .featured-card {
    background: linear-gradient(135deg, var(--color-bg-surface) 0%, var(--color-bg-elevated) 100%);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px var(--color-accent-glow);
  }

  .featured-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-8);
    text-decoration: none;
    color: inherit;
    gap: var(--space-6);
  }

  .featured-card__content {
    flex: 1;
    min-width: 0;
  }

  .featured-card__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .featured-card__description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .featured-card__date {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .featured-card__arrow {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform 0.3s ease;
  }

  .featured-card:hover .featured-card__arrow {
    transform: translateX(8px);
  }

  @media (max-width: 768px) {
    .blog__header {
      padding: var(--space-12) 0 var(--space-8);
    }

    .featured-card__link {
      padding: var(--space-6);
    }

    .featured-card__title {
      font-size: var(--text-xl);
    }

    .featured-card__description {
      font-size: var(--text-base);
    }

    .featured-card__arrow {
      display: none;
    }
  }

  /* Portrait video in footer - same size as social icons */
  .portrait-video-link {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .portrait-video-link:hover {
    transform: translateY(-2px);
  }
</style>
