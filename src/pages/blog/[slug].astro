---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = `${post.data.title} | Mulloy Morrow`;
const description = post.data.description;
const canonicalUrl = `https://code.mulloymorrow.com/blog/${post.slug}/`;

const formattedDate = post.data.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const formattedUpdatedDate = post.data.updatedAt?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// JSON-LD BlogPosting Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.publishedAt.toISOString(),
  "dateModified": (post.data.updatedAt || post.data.publishedAt).toISOString(),
  "author": {
    "@type": "Person",
    "name": "Mulloy Morrow",
    "url": "https://code.mulloymorrow.com",
    "jobTitle": "Director / Head of AI & Machine Learning",
    "sameAs": [
      "https://linkedin.com/in/mulloymorrow",
      "https://twitter.com/thismulloy",
      "https://github.com/mulloymorrow"
    ]
  },
  "publisher": {
    "@type": "Person",
    "name": "Mulloy Morrow"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  ...(post.data.image && { "image": post.data.image }),
  ...(post.data.tags && { "keywords": post.data.tags.join(", ") })
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  
  <article class="blog-post">
    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      <a href="/blog">Blog</a>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      <span class="breadcrumb__current">{post.data.title}</span>
    </nav>

    <header class="blog-post__header container">
      <div class="blog-post__meta animate-on-scroll">
        <time datetime={post.data.publishedAt.toISOString()}>
          {formattedDate}
        </time>
        {post.data.updatedAt && (
          <span class="blog-post__updated">
            (Updated: {formattedUpdatedDate})
          </span>
        )}
      </div>
      <h1 class="blog-post__title animate-on-scroll delay-1">{post.data.title}</h1>
      <p class="blog-post__description animate-on-scroll delay-2">{post.data.description}</p>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="blog-post__tags animate-on-scroll delay-3">
          {post.data.tags.map(tag => (
            <span class="blog-post__tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="blog-post__content container animate-on-scroll delay-4">
      <Content />
    </div>

    <footer class="blog-post__footer container">
      <div class="blog-post__author">
        <div class="author__info">
          <span class="author__name">Mulloy Morrow</span>
          <span class="author__title">Director / Head of AI & Machine Learning</span>
        </div>
      </div>
      <div class="blog-post__nav">
        <a href="/blog" class="blog-post__back">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          <span>Back to Blog</span>
        </a>
      </div>
    </footer>
  </article>
  <Footer />
</Layout>

<style>
  .blog-post {
    min-height: 100vh;
    padding-top: var(--space-8);
  }

  .breadcrumb {
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb__separator {
    margin: 0 var(--space-2);
    color: var(--color-border);
  }

  .breadcrumb__current {
    color: var(--color-text-primary);
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    vertical-align: bottom;
  }

  .blog-post__header {
    max-width: var(--content-width);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }

  .blog-post__meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .blog-post__updated {
    margin-left: var(--space-2);
    color: var(--color-text-muted);
  }

  .blog-post__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  .blog-post__description {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-post__tag {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-glow);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .blog-post__content {
    max-width: var(--content-width);
    padding-bottom: var(--space-12);
  }

  /* Prose styles for markdown content */
  .blog-post__content :global(h1),
  .blog-post__content :global(h2),
  .blog-post__content :global(h3),
  .blog-post__content :global(h4) {
    color: var(--color-text-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .blog-post__content :global(h1) {
    font-size: var(--text-3xl);
  }

  .blog-post__content :global(h2) {
    font-size: var(--text-2xl);
  }

  .blog-post__content :global(h3) {
    font-size: var(--text-xl);
  }

  .blog-post__content :global(p) {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .blog-post__content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-post__content :global(a:hover) {
    color: var(--color-text-primary);
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    margin: var(--space-6) 0;
    padding-left: var(--space-6);
  }

  .blog-post__content :global(li) {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .blog-post__content :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .blog-post__content :global(em) {
    color: var(--color-accent);
    font-style: italic;
  }

  .blog-post__content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-6);
    margin: var(--space-8) 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .blog-post__content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-bg-elevated);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
    color: var(--color-accent);
  }

  .blog-post__content :global(pre) {
    background: var(--color-bg-elevated);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: var(--space-6) 0;
    border: 1px solid var(--color-border);
  }

  .blog-post__content :global(pre code) {
    background: none;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .blog-post__content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-8) 0;
  }

  .blog-post__content :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: var(--space-12) 0;
  }

  .blog-post__footer {
    max-width: var(--content-width);
    padding: var(--space-8) 0 var(--space-16);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .blog-post__author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .author__info {
    display: flex;
    flex-direction: column;
  }

  .author__name {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .author__title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .blog-post__nav {
    display: flex;
    gap: var(--space-4);
  }

  .blog-post__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .blog-post__back:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  @media (max-width: 768px) {
    .blog-post__header {
      padding: var(--space-8) 0;
    }

    .blog-post__footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .blog-post__content :global(p),
    .blog-post__content :global(li) {
      font-size: var(--text-base);
    }
  }
</style>
