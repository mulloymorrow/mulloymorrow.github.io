---
import BlogPostCard from './BlogPostCard.astro';
import { standaloneEssays } from '../data/writing';

const featured = [...standaloneEssays].sort(
  (a, b) => b.publishedAt.getTime() - a.publishedAt.getTime()
);
---

<section class="writing section" id="writing">
  <div class="container">
    <div class="writing__header animate-on-scroll">
      <span class="writing__label">Writing</span>
      <h2 class="writing__title">What I&rsquo;m writing</h2>
      <p class="writing__lede">
        Long-form essays on the mind, longevity, and how to train — plus notes on recommendation systems and building.
      </p>
    </div>

    <div class="writing__list">
      {featured.map((essay) => (
        <BlogPostCard
          title={essay.title}
          description={essay.description}
          slug={essay.slug}
          publishedAt={essay.publishedAt}
          tags={essay.tags}
          isExternal={true}
          visual={essay.visual}
        />
      ))}
    </div>

    <a href="/blog/" class="writing__all">
      <span>All writing</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .writing {
    padding: var(--space-24) 0;
  }

  .writing__header {
    max-width: 640px;
    margin: 0 auto var(--space-10);
    text-align: center;
  }

  .writing__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }

  .writing__title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4);
  }

  .writing__lede {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .writing__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .writing__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-8) auto 0;
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent);
    color: white;
    font-weight: 600;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .writing :global(.container) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .writing__list {
    width: 100%;
  }

  .writing__all:hover {
    background: var(--color-accent-dim);
    transform: translateX(4px);
    color: white;
  }

  @media (max-width: 768px) {
    .writing__title {
      font-size: var(--text-2xl);
    }
  }
</style>
