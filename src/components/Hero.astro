---
import SocialLinks from './SocialLinks.astro';
---

<section class="hero" id="top">
  <div class="hero__background">
    <div class="hero__blob hero__blob--1"></div>
    <div class="hero__blob hero__blob--2"></div>
    <div class="hero__blob hero__blob--3"></div>
    <div class="hero__pattern"></div>
  </div>
  
  <div class="hero__content container">
    <div class="hero__intro animate-on-scroll">
      <span class="hero__wave">👋</span>
      <span class="hero__greeting">Hey there, I'm</span>
    </div>
    
    <h1 class="hero__name animate-on-scroll delay-1">
      Mulloy Morrow
    </h1>
    
    <h2 class="hero__title animate-on-scroll delay-2">
      Director / Head of <span class="text-accent">AI & Machine Learning</span>
    </h2>
    
    <p class="hero__tagline animate-on-scroll delay-3">
      Building AI systems that matter — from personalization at scale to human-centered products
    </p>
    
    <div class="hero__cta animate-on-scroll delay-4">
      <SocialLinks size="lg" />
    </div>
    
    <a href="#experience" class="hero__scroll-indicator animate-on-scroll delay-5" aria-label="Scroll to experience">
      <span class="hero__scroll-text">Explore my journey</span>
      <svg class="hero__scroll-arrow" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  
  .hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  
  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: float-blob 20s ease-in-out infinite;
  }
  
  .hero__blob--1 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, var(--color-accent-glow) 0%, rgba(244, 162, 97, 0.15) 100%);
    top: -15%;
    right: -10%;
    animation-delay: 0s;
    transition: background var(--theme-transition);
  }
  
  .hero__blob--2 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, rgba(69, 123, 157, 0.15) 0%, var(--color-accent-glow) 100%);
    bottom: -10%;
    left: -10%;
    animation-delay: -7s;
    transition: background var(--theme-transition);
  }
  
  .hero__blob--3 {
    width: 300px;
    height: 300px;
    background: linear-gradient(135deg, rgba(244, 162, 97, 0.2) 0%, var(--color-accent-glow) 100%);
    top: 40%;
    left: 60%;
    animation-delay: -14s;
    transition: background var(--theme-transition);
  }
  
  @keyframes float-blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(20px, -20px) scale(1.05); }
    50% { transform: translate(-10px, 20px) scale(0.95); }
    75% { transform: translate(-20px, -10px) scale(1.02); }
  }
  
  .hero__pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, var(--color-border) 1px, transparent 0);
    background-size: 40px 40px;
    opacity: 0.4;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }
  
  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-8) 0;
  }
  
  .hero__intro {
    margin-bottom: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }
  
  .hero__wave {
    font-size: var(--text-2xl);
    animation: wave 2.5s ease-in-out infinite;
    transform-origin: 70% 70%;
    display: inline-block;
  }
  
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60%, 100% { transform: rotate(0deg); }
  }
  
  .hero__greeting {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }
  
  .hero__name {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    /* Elegant silver-to-ice gradient for dark theme, warm coral for light */
    background: linear-gradient(135deg, #f8fafc 0%, #94a3b8 40%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: background var(--theme-transition);
  }
  
  /* Warm theme name gradient */
  :global(.theme-warm) .hero__name {
    background: linear-gradient(135deg, #1e293b 0%, #475569 40%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .hero__title {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
  
  .hero__tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto var(--space-10);
    letter-spacing: 0.02em;
  }
  
  .hero__cta {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-16);
  }
  
  .hero__scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    transition: color var(--transition-base);
    animation: float 3s ease-in-out infinite;
  }
  
  .hero__scroll-indicator:hover {
    color: var(--color-accent);
  }
  
  .hero__scroll-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  .hero__scroll-arrow {
    animation: bounce 2s ease-in-out infinite;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(8px); }
    60% { transform: translateY(4px); }
  }
  
  @media (max-width: 768px) {
    .hero__tagline {
      font-size: var(--text-base);
    }
    
    .hero__scroll-indicator {
      display: none;
    }
  }
</style>

