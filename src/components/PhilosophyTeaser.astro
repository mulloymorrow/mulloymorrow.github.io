---
// Philosophy teaser section for homepage
---

<section class="philosophy-teaser section" id="philosophy">
  <div class="container">
    <div class="teaser__card animate-on-scroll">
      <div class="teaser__content">
        <div class="teaser__header">
          <span class="teaser__label">Philosophy</span>
          <h2 class="teaser__title">What Drives Me</h2>
        </div>
        
        <blockquote class="teaser__quote">
          <p>"We're living through the most transformative technological revolution in human history, and we're just getting started."</p>
        </blockquote>
        
        <p class="teaser__description">
          I believe AI's greatest potential lies in <strong>multiplying human capability</strong> and <strong>extending opportunity</strong> to more people. I build technology that unlocks human potential rather than constrains it.
        </p>
        
        <a href="/philosophy" class="teaser__cta">
          <span>Read My Philosophy</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
      
      <div class="teaser__decoration" aria-hidden="true">
        <div class="teaser__icon">
          <!-- Dopamine molecule - pencil sketch style -->
          <!-- Structure: catechol (benzene + 2 adjacent OH) + ethyl chain + NH2 -->
          <svg xmlns="http://www.w3.org/2000/svg" width="140" height="140" viewBox="0 0 120 100" fill="none" stroke="currentColor" class="dopamine-molecule">
            <!-- Benzene ring (hexagon) -->
            <path d="M30 30 L45 22 L60 30 L60 46 L45 54 L30 46 Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- Alternating double bonds (inside the ring) -->
            <path d="M34 32 L34 44" stroke-width="1" opacity="0.6"/>
            <path d="M46 25 L56 30" stroke-width="1" opacity="0.6"/>
            <path d="M56 46 L46 51" stroke-width="1" opacity="0.6"/>
            
            <!-- First HO group (top-left of ring, position 3) -->
            <path d="M30 30 L20 25" stroke-width="1.5" stroke-linecap="round"/>
            <text x="4" y="28" font-size="9" font-family="monospace" fill="currentColor" stroke="none" class="molecule-label">HO</text>
            
            <!-- Second HO group (bottom-left of ring, position 4, adjacent to first) -->
            <path d="M30 46 L20 51" stroke-width="1.5" stroke-linecap="round"/>
            <text x="4" y="55" font-size="9" font-family="monospace" fill="currentColor" stroke="none" class="molecule-label">HO</text>
            
            <!-- Ethyl chain: ring -> CH2 -> CH2 -> NH2 -->
            <!-- First CH2 (from ring position 1) -->
            <path d="M60 38 L75 38" stroke-width="1.5" stroke-linecap="round"/>
            <!-- Second CH2 -->
            <path d="M75 38 L90 48" stroke-width="1.5" stroke-linecap="round"/>
            
            <!-- NH2 amine group at end -->
            <text x="92" y="56" font-size="9" font-family="monospace" fill="currentColor" stroke="none" class="molecule-label">NH</text>
            <text x="105" y="59" font-size="6" font-family="monospace" fill="currentColor" stroke="none" class="molecule-label">2</text>
            
            <!-- Small vertex dots for sketch feel -->
            <circle cx="75" cy="38" r="1.5" fill="currentColor" opacity="0.3"/>
            <circle cx="90" cy="48" r="1.5" fill="currentColor" opacity="0.3"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .philosophy-teaser {
    padding: var(--space-16) 0;
    position: relative;
    overflow: hidden;
  }
  
  .teaser__card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-6);
    align-items: center;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    position: relative;
    overflow: hidden;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .teaser__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-warm));
  }
  
  .teaser__content {
    position: relative;
    z-index: 1;
  }
  
  .teaser__header {
    margin-bottom: var(--space-4);
  }
  
  .teaser__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-1);
  }
  
  .teaser__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .teaser__quote {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    margin: var(--space-4) 0;
  }
  
  .teaser__quote p {
    font-size: var(--text-base);
    font-style: italic;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }
  
  .teaser__description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    max-width: 500px;
  }
  
  .teaser__description strong {
    color: var(--color-text-primary);
  }
  
  .teaser__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent);
    color: white;
    font-weight: 600;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }
  
  .teaser__cta:hover {
    background: var(--color-accent-dim);
    transform: translateX(4px);
    box-shadow: var(--shadow-lg);
    color: white;
  }
  
  .teaser__cta svg {
    transition: transform var(--transition-base);
  }
  
  .teaser__cta:hover svg {
    transform: translateX(4px);
  }
  
  .teaser__decoration {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .teaser__icon {
    width: 160px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-glow);
    border-radius: 40%;
    color: var(--color-accent);
    animation: float 6s ease-in-out infinite;
  }
  
  /* Pencil sketch style for dopamine molecule */
  .dopamine-molecule {
    filter: url(#pencil-texture);
  }
  
  .dopamine-molecule path,
  .dopamine-molecule circle {
    stroke-dasharray: 0.5 0.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  
  /* Keep text labels clean (no dashed stroke) */
  .dopamine-molecule text,
  .dopamine-molecule .molecule-label {
    stroke: none;
    stroke-dasharray: none;
    font-weight: 500;
    opacity: 0.85;
  }
  
  .teaser__icon:hover .dopamine-molecule {
    filter: none;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  @media (max-width: 768px) {
    .teaser__card {
      grid-template-columns: 1fr;
      padding: var(--space-5);
    }
    
    .teaser__decoration {
      display: none;
    }
    
    .teaser__title {
      font-size: var(--text-xl);
    }
    
    .teaser__quote p {
      font-size: var(--text-sm);
    }
    
    .teaser__description {
      font-size: var(--text-sm);
    }
  }
</style>
