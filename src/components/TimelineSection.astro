<section class="timeline section" id="experience">
  <div class="container">
    <div class="timeline__header animate-on-scroll">
      <h2 class="timeline__title">Experience</h2>
      <p class="timeline__subtitle">A journey through AI/ML leadership and product development</p>
    </div>
    
    <div class="timeline__list">
      {experiences.map((exp, index) => (
        <div class={`animate-on-scroll delay-${Math.min(index + 1, 5)}`}>
          <TimelineCard experience={exp} client:visible />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    padding: var(--space-24) 0;
  }
  
  .timeline__header {
    text-align: center;
    margin-bottom: var(--space-16);
  }
  
  .timeline__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .timeline__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 500px;
    margin: 0 auto;
  }
  
  .timeline__list {
    max-width: 800px;
    margin: 0 auto;
  }
</style>

