---
import type { TrellisCard } from '../../data/trellis';

interface Props {
  card: TrellisCard;
  personaId: string;
  cardIndex: number;
}

const { card, personaId, cardIndex } = Astro.props;
const tierLabel: Record<string, string> = { t1: 'T1', t2: 'T2', t3: 'T3', t4: 'T4' };
const tierText = tierLabel[card.tier] ?? card.tier.toUpperCase();
const data = card.data;
const cardKey = `${personaId}-${cardIndex}`;

const series: number[] = data.series ?? [];
const labels: string[] = data.labels ?? [];
let sparkPath = '';
let sparkPoints: Array<{ x: number; y: number; latest: boolean }> = [];

if (series.length > 0) {
  const width = 320;
  const height = 76;
  const pad = 10;
  const min = Math.min(...series);
  const max = Math.max(...series);
  const span = Math.max(max - min, 1);
  sparkPoints = series.map((value, index) => ({
    x: pad + (index / Math.max(series.length - 1, 1)) * (width - pad * 2),
    y: height - pad - ((value - min) / span) * (height - pad * 2.4),
    latest: index === series.length - 1,
  }));
  sparkPath = sparkPoints
    .map((point, index) => `${index === 0 ? 'M' : 'L'}${point.x.toFixed(1)} ${point.y.toFixed(1)}`)
    .join(' ');
}
---

{card.type === 'followup' && (
  <article class="trellis-card trellis-card--inverse" data-ack={data.ack} data-escalation={data.escalation}>
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow trellis-eyebrow--inverse">{data.eyebrow}</div>
    <h3 class="trellis-headline trellis-headline--inverse">{data.headline}</h3>
    <p class="trellis-sub trellis-sub--inverse">{data.sub}</p>
    <div class="trellis-pill-row" data-followup-prompt>
      {data.responses.map((response: string) => (
        <button type="button" class="trellis-pill-button" data-followup-response={response} data-card-key={cardKey}>
          {response}
        </button>
      ))}
    </div>
    <div class="trellis-ack" data-followup-ack hidden>
      <div class="trellis-ack__label" data-followup-label></div>
      <div class="trellis-ack__text" data-followup-text></div>
    </div>
    <div class="trellis-why trellis-why--inverse">{data.why}</div>
  </article>
)}

{card.type === 'trend' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow">{data.eyebrow}</div>
    <h3 class="trellis-headline">{data.headline}</h3>
    <div class="trellis-sparkline">
      <svg viewBox="0 0 320 76" aria-label="Trend sparkline">
        <rect x="10" y="10" width="300" height="56" rx="6" class="trellis-sparkline__bg"></rect>
        <path d={sparkPath} class="trellis-sparkline__path"></path>
        {sparkPoints.map((point) => (
          <circle cx={point.x} cy={point.y} r={point.latest ? 4 : 2.8} class:list={['trellis-sparkline__point', point.latest && 'trellis-sparkline__point--latest']}></circle>
        ))}
      </svg>
      <div class="trellis-sparkline__labels">
        {labels.map((label) => <span>{label}</span>)}
      </div>
    </div>
    <div class="trellis-meta-row">
      <span class="trellis-meta trellis-meta--clock">{data.unit}</span>
      <span class="trellis-meta trellis-meta--clock">{data.freshness}</span>
    </div>
    <div class="trellis-why">{data.why}</div>
  </article>
)}

{card.type === 'apptprep' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow">{data.eyebrow}</div>
    <h3 class="trellis-headline">{data.title}</h3>
    <p class="trellis-sub">{data.sub}</p>
    <div class="trellis-question-list">
      {data.items.map((item: string, index: number) => (
        <div class="trellis-question">
          <span class="trellis-question__index">{String(index + 1).padStart(2, '0')}</span>
          <span>{item}</span>
        </div>
      ))}
    </div>
    <div class="trellis-meta-row">
      <button type="button" class="trellis-inline-button">{data.cta}</button>
      <span class="trellis-subtle">{data.clinician}</span>
    </div>
    <div class="trellis-why">{data.why}</div>
  </article>
)}

{card.type === 'screening' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow">{data.eyebrow}</div>
    <h3 class="trellis-headline">{data.title}</h3>
    <p class="trellis-sub">{data.sub}</p>
    <div class="trellis-window">
      <div class="trellis-window__bar">
        <span class="trellis-window__marker" style={`left:${((data.window.now - data.window.lo) / (data.window.hi - data.window.lo)) * 100}%`}></span>
      </div>
      <div class="trellis-window__labels">
        <span>WK {data.window.lo}</span>
        <span>YOU · WK {data.window.now}</span>
        <span>WK {data.window.hi}</span>
      </div>
    </div>
    <div class="trellis-pill-row" data-screening-actions>
      <button type="button" class="trellis-inline-button">Book</button>
      <button type="button" class="trellis-inline-button trellis-inline-button--light" data-screening-done data-card-key={cardKey}>Mark done</button>
      <button type="button" class="trellis-inline-button trellis-inline-button--ghost" data-open-journey={data.journeyId}>View on journey</button>
    </div>
    <div class="trellis-success" data-screening-success hidden>
      Marked done — we&apos;ll confirm it against your record.
    </div>
    <div class="trellis-meta-row">
      <div class="trellis-why">{data.why}</div>
      <span class="trellis-meta">{data.source}</span>
    </div>
  </article>
)}

{card.type === 'drugsafety' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-med">
      <div class="trellis-med__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.5 3.5l10 10a4.95 4.95 0 01-7 7l-10-10a4.95 4.95 0 017-7z"/>
          <path d="M8.5 15.5l7-7"/>
        </svg>
      </div>
      <div>
        <div class="trellis-eyebrow">{data.eyebrow}</div>
        <div class="trellis-med__name">{data.med}</div>
      </div>
    </div>
    <h3 class="trellis-headline">{data.title}</h3>
    <div class="trellis-meta-stack">
      <div class="trellis-meta">{data.citation}</div>
      <p class="trellis-sub trellis-sub--tight">{data.disclaimer}</p>
    </div>
    <div class="trellis-meta-row">
      <button type="button" class="trellis-inline-button trellis-inline-button--light">{data.cta}</button>
      <div class="trellis-why">{data.why}</div>
    </div>
  </article>
)}

{card.type === 'knowledge' && (
  <article class="trellis-card trellis-card--flush">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-image-band">
      <img src={data.img} alt="" />
    </div>
    <div class="trellis-card__body">
      <div class="trellis-eyebrow">{data.eyebrow}</div>
      <h3 class="trellis-headline">{data.title}</h3>
      {data.sub && <p class="trellis-sub">{data.sub}</p>}
      <div class="trellis-meta-row trellis-meta-row--start">
        <span class="trellis-meta trellis-meta--clock">{data.mins}</span>
        <span class="trellis-meta trellis-meta--shield">{data.reviewed}</span>
      </div>
    </div>
  </article>
)}

{card.type === 'careteam' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow">{data.eyebrow}</div>
    <div class="trellis-person">
      <div class="trellis-avatar">{data.name.split(' ').map((part: string) => part[0]).join('').slice(0, 2)}</div>
      <div>
        <div class="trellis-person__top">
          <span class="trellis-person__name">{data.name}</span>
          <span class="trellis-meta">{data.when}</span>
        </div>
        <p class="trellis-sub trellis-sub--tight">{data.note}</p>
      </div>
    </div>
  </article>
)}

{card.type === 'debrief' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-meta-row">
      <div class="trellis-eyebrow">{data.eyebrow}</div>
      <span class="trellis-meta trellis-meta--shield">{data.reviewed}</span>
    </div>
    <h3 class="trellis-headline">{data.title}</h3>
    <p class="trellis-sub">{data.sub}</p>
    <div class="trellis-callout">{data.change}</div>
    <div class="trellis-why">{data.why}</div>
  </article>
)}

{card.type === 'continuity' && (
  <article class="trellis-card trellis-card--inverse">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow trellis-eyebrow--inverse">{data.eyebrow}</div>
    <h3 class="trellis-headline trellis-headline--inverse">{data.headline}</h3>
    <div class="trellis-care-pill">
      <div class="trellis-avatar trellis-avatar--inverse">{data.person.name.split(' ').map((part: string) => part[0]).join('').slice(0, 2)}</div>
      <div class="trellis-care-pill__body">
        <div class="trellis-care-pill__name">{data.person.name}</div>
        <div class="trellis-care-pill__role">{data.person.role}</div>
      </div>
      <button type="button" class="trellis-inline-button trellis-inline-button--accent">{data.person.cta}</button>
    </div>
    <div class="trellis-why trellis-why--inverse">{data.why}</div>
  </article>
)}

{card.type === 'milestone' && (
  <article class="trellis-card trellis-card--warm">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow">{data.eyebrow}</div>
    <h3 class="trellis-headline">{data.headline}</h3>
    <div class="trellis-stats">
      {data.stats.map((stat: { value: string; label: string }) => (
        <div>
          <div class="trellis-stats__value">{stat.value}</div>
          <div class="trellis-stats__label">{stat.label}</div>
        </div>
      ))}
    </div>
    <button type="button" class="trellis-inline-button trellis-inline-button--light" data-open-journey>{data.cta}</button>
  </article>
)}

{card.type === 'checkin' && (
  <article class="trellis-card">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-person trellis-person--icon">
      <div class="trellis-icon-bubble">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a8 8 0 01-8 8H4l2.5-2.5A8 8 0 1121 12z"/>
        </svg>
      </div>
      <div>
        <div class="trellis-person__name">{data.title}</div>
        <p class="trellis-sub trellis-sub--tight">{data.sub}</p>
      </div>
    </div>
    <button type="button" class="trellis-inline-button trellis-inline-button--light">{data.cta}</button>
  </article>
)}

{card.type === 'weekly' && (
  <article class="trellis-card trellis-card--warm trellis-card--compact">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div>
      <div class="trellis-eyebrow">{data.eyebrow}</div>
      <h3 class="trellis-headline trellis-headline--compact">{data.title}</h3>
    </div>
    <span class="trellis-meta">{data.mins}</span>
  </article>
)}

{card.type === 'feedback' && (
  <article class="trellis-feedback" data-feedback-card>
    <span class="trellis-subtle" data-feedback-label>{data.prompt}</span>
    <div class="trellis-feedback__actions" data-feedback-actions>
      <button type="button" class="trellis-feedback__button" data-feedback-value="Yes">Yes</button>
      <button type="button" class="trellis-feedback__button" data-feedback-value="Not really">Not really</button>
    </div>
  </article>
)}

{card.type === 'coldstart' && (
  <article class="trellis-card trellis-card--inverse">
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-eyebrow trellis-eyebrow--inverse">{data.eyebrow}</div>
    <h3 class="trellis-headline trellis-headline--inverse">{data.headline}</h3>
    <div class="trellis-slot-grid">
      {data.slots.map((slot: { label: string; filled: boolean }) => (
        <div class:list={['trellis-slot', !slot.filled && 'trellis-slot--empty']}>
          <span class:list={['trellis-slot__dot', !slot.filled && 'trellis-slot__dot--empty']}></span>
          <span>{slot.label}</span>
        </div>
      ))}
    </div>
  </article>
)}

{card.type === 'journeylink' && (
  <article class="trellis-card trellis-card--link" data-open-journey>
    <div class={`trellis-card-tier trellis-card-tier--${card.tier}`}>{tierText}</div>
    <div class="trellis-icon-bubble trellis-icon-bubble--aqua">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 4l6 2 6-2v14l-6 2-6-2-6 2V6z"/>
        <path d="M9 4v14"/>
        <path d="M15 6v14"/>
      </svg>
    </div>
    <div class="trellis-card__link-copy">
      <div class="trellis-eyebrow">{data.eyebrow}</div>
      <h3 class="trellis-headline trellis-headline--link">{data.title}</h3>
      <p class="trellis-sub trellis-sub--tight">{data.sub}</p>
    </div>
    <svg class="trellis-link-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
  </article>
)}
