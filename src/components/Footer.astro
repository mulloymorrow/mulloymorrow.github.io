---
import SocialLinks from './SocialLinks.astro';
import PingPongVideo from './PingPongVideo.svelte';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__content">
      <div class="footer__brand">
        <span class="footer__name">Mulloy Morrow</span>
        <span class="footer__tagline">Building AI systems that matter</span>
        <nav class="footer__nav" aria-label="Footer">
          <a href="/blog/">Writing</a>
          <a href="/blog/the-body-beneath-the-feeling/">The Body Beneath the Feeling</a>
          <a href="/philosophy">Philosophy</a>
          <a href="/blog/rss.xml">RSS</a>
        </nav>
      </div>
      
      <SocialLinks size="md">
        <a href="/ai-mulloy/" class="ai-mulloy-link" title="Chat with AI-Mulloy">
          <PingPongVideo client:load src="/video/portrait_drawing.mp4" className="ai-mulloy-video" />
        </a>
        <slot name="social-extra" />
      </SocialLinks>
    </div>
    
    <div class="footer__bottom">
      <p class="footer__copyright">
        © {currentYear} Mulloy Morrow. All rights reserved.
      </p>
      <p class="footer__built">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> + <a href="https://svelte.dev" target="_blank" rel="noopener noreferrer">Svelte</a> + <a href="https://www.anthropic.com/news/claude-opus-4-5" target="_blank" rel="noopener noreferrer">Claude Opus 4.5</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-16) 0 var(--space-8);
    border-top: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg-primary) 100%);
    position: relative;
  }
  
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }
  
  .footer__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }
  
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  
  .footer__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  
  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .footer__nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__nav a:hover {
    color: var(--color-accent);
  }
  
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  
  .footer__copyright,
  .footer__built {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .footer__built a {
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  .footer__built a:hover {
    color: var(--color-text-primary);
  }
  
  @media (max-width: 640px) {
    .footer__content {
      flex-direction: column;
      text-align: center;
    }
    
    .footer__brand {
      align-items: center;
    }
    
    .footer__bottom {
      flex-direction: column;
      gap: var(--space-2);
      text-align: center;
    }
  }
  
  /* AI-Mulloy video link in social links (md = 22px) */
  .ai-mulloy-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    overflow: hidden;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 0 0 1.5px var(--color-border);
  }
  
  .ai-mulloy-link:hover {
    transform: translateY(-2px) scale(1.1);
    box-shadow: 0 0 8px var(--color-accent-glow), 0 0 0 1.5px var(--color-accent);
  }
  
  .ai-mulloy-link :global(.ai-mulloy-video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.5);
  }
</style>

