---
interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  tags?: string[];
  isExternal?: boolean;
  visual?: string;
}

const { title, description, slug, publishedAt, tags, isExternal = false, visual = 'fallback' } = Astro.props;

const formattedDate = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const href = isExternal ? slug : `/blog/${slug}/`;
---

<article class="blog-card">
  <a href={href} class="blog-card__link">
    <div class="blog-card__visual" aria-hidden="true" data-visual={visual}>
      {visual === 'physiology' && (
        <svg viewBox="0 0 96 96" fill="none">
          <rect x="8" y="18" width="80" height="60" rx="10" fill="var(--color-bg-elevated)" stroke="var(--color-border)"/>
          <circle cx="22" cy="36" r="6" fill="var(--color-accent)"/>
          <circle cx="38" cy="36" r="6" fill="var(--color-accent)" opacity="0.75"/>
          <circle cx="54" cy="36" r="6" fill="var(--color-accent)" opacity="0.55"/>
          <circle cx="70" cy="36" r="6" fill="var(--color-accent)" opacity="0.4"/>
          <circle cx="30" cy="60" r="6" fill="var(--color-accent)" opacity="0.85"/>
          <circle cx="48" cy="60" r="6" fill="var(--color-accent)" opacity="0.6"/>
          <circle cx="66" cy="60" r="6" fill="var(--color-accent)" opacity="0.35"/>
          <path d="M28 36h4M44 36h4M60 36h4M36 48v6M48 42v12M60 42v12" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.45"/>
        </svg>
      )}
      {visual === 'longevity' && (
        <svg viewBox="0 0 96 96" fill="none">
          <circle cx="48" cy="50" r="28" fill="var(--color-bg-elevated)" stroke="var(--color-border)"/>
          <path d="M48 22a28 28 0 0 1 24.2 14H48V22Z" fill="var(--color-accent)"/>
          <path d="M72.2 36A28 28 0 0 1 38 77.4L48 50h24.2Z" fill="var(--color-accent)" opacity="0.45"/>
          <path d="M38 77.4A28 28 0 0 1 20 50h28L38 77.4Z" fill="var(--color-accent)" opacity="0.7"/>
          <circle cx="48" cy="50" r="7" fill="var(--color-bg-surface)"/>
        </svg>
      )}
      {visual === 'feeling' && (
        <svg viewBox="0 0 96 96" fill="none">
          <circle cx="48" cy="48" r="32" stroke="var(--color-accent)" stroke-width="2" opacity="0.3"/>
          <circle cx="48" cy="48" r="22" stroke="var(--color-accent)" stroke-width="2" opacity="0.55"/>
          <circle cx="48" cy="48" r="12" stroke="var(--color-accent)" stroke-width="2"/>
          <circle cx="48" cy="48" r="5" fill="var(--color-accent)"/>
        </svg>
      )}
      {visual === 'defense' && (
        <svg viewBox="0 0 96 96" fill="none">
          <rect x="18" y="16" width="60" height="11" rx="3" fill="var(--color-accent)"/>
          <rect x="18" y="31" width="60" height="11" rx="3" fill="var(--color-accent)" opacity="0.8"/>
          <rect x="18" y="46" width="60" height="11" rx="3" fill="var(--color-accent)" opacity="0.6"/>
          <rect x="18" y="61" width="60" height="11" rx="3" fill="var(--color-accent)" opacity="0.4"/>
          <rect x="18" y="76" width="60" height="11" rx="3" fill="var(--color-accent)" opacity="0.22"/>
        </svg>
      )}
      {visual === 'trellis' && (
        <svg viewBox="0 0 96 96" fill="none">
          <path d="M16 68 C32 28, 64 28, 80 68" stroke="var(--color-accent)" stroke-width="2.5" fill="none"/>
          <circle cx="16" cy="68" r="5" fill="var(--color-accent)"/>
          <circle cx="48" cy="38" r="6" fill="var(--color-accent)"/>
          <circle cx="80" cy="68" r="5" fill="var(--color-accent)" opacity="0.7"/>
          <path d="M16 76h64" stroke="var(--color-border)" stroke-width="2" stroke-dasharray="3 4"/>
        </svg>
      )}
      {visual === 'spotify' && (
        <svg viewBox="0 0 96 96" fill="none">
          <path d="M18 22h60l-10 16H28L18 22Z" fill="var(--color-accent)" opacity="0.35"/>
          <path d="M28 42h40l-8 16H36L28 42Z" fill="var(--color-accent)" opacity="0.65"/>
          <path d="M36 62h24l-8 14h-8L36 62Z" fill="var(--color-accent)"/>
        </svg>
      )}
      {visual === 'philosophy' && (
        <svg viewBox="0 0 96 96" fill="none">
          <circle cx="48" cy="28" r="8" fill="var(--color-accent)"/>
          <circle cx="26" cy="66" r="8" fill="var(--color-accent)" opacity="0.7"/>
          <circle cx="70" cy="66" r="8" fill="var(--color-accent)" opacity="0.45"/>
          <path d="M48 36L26 58M48 36L70 58M34 66h28" stroke="var(--color-accent)" stroke-width="2" opacity="0.55"/>
        </svg>
      )}
      {visual !== 'physiology' && visual !== 'longevity' && visual !== 'feeling' && visual !== 'defense' && visual !== 'trellis' && visual !== 'spotify' && visual !== 'philosophy' && (
        <svg viewBox="0 0 96 96" fill="none">
          <defs>
            <pattern id="card-hash" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
              <line x1="0" y1="0" x2="0" y2="8" stroke="var(--color-accent)" stroke-width="2" opacity="0.45"/>
            </pattern>
          </defs>
          <rect x="12" y="12" width="72" height="72" rx="12" fill="url(#card-hash)" stroke="var(--color-border)"/>
        </svg>
      )}
    </div>
    <div class="blog-card__content">
      <time class="blog-card__date" datetime={publishedAt.toISOString()}>
        {formattedDate}
      </time>
      <h3 class="blog-card__title">{title}</h3>
      <p class="blog-card__description">{description}</p>
      {tags && tags.length > 0 && (
        <div class="blog-card__tags">
          {tags.map(tag => (
            <span class="blog-card__tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
    <div class="blog-card__arrow">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </div>
  </a>
</article>

<style>
  .blog-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .blog-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .blog-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5, 1.25rem) var(--space-6);
    text-decoration: none;
    color: inherit;
    gap: var(--space-4);
  }

  .blog-card__visual {
    flex: none;
    width: 88px;
    height: 88px;
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 30% 20%, var(--color-accent-glow), transparent 62%),
      var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .blog-card__visual svg {
    width: 100%;
    height: 100%;
  }

  .blog-card__content {
    flex: 1;
    min-width: 0;
  }

  .blog-card__date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .blog-card__title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    transition: color var(--transition-fast);
  }

  .blog-card:hover .blog-card__title {
    color: var(--color-accent);
  }

  .blog-card__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-card__tag {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-glow);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .blog-card__arrow {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card__arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-card__link {
      padding: var(--space-4);
      align-items: flex-start;
    }

    .blog-card__visual {
      width: 64px;
      height: 64px;
    }

    .blog-card__title {
      font-size: var(--text-lg);
    }

    .blog-card__arrow {
      display: none;
    }
  }
</style>
