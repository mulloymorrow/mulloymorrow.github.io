---
// Contact section with Google Calendar booking
---

<section class="contact section" id="contact">
  <div class="container">
    <div class="contact__header animate-on-scroll">
      <h2 class="contact__title">Let's Connect</h2>
      <p class="contact__subtitle">
        Interested in collaborating, discussing AI/ML, or just saying hello? 
        Book a time that works for you.
      </p>
    </div>
    
    <div class="contact__content animate-on-scroll delay-1">
      <div class="contact__intro">
        <div class="contact__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <p class="contact__description">
          Whether you're exploring a new venture, need ML expertise, or want to chat about 
          building AI systems that matter — I'd love to hear from you.
        </p>
      </div>
      
      <div class="contact__calendar">
        <iframe 
          src="https://calendar.google.com/calendar/appointments/AcZssZ0oXa6OFoGV-CgTGC4kL_IqweyP87-YxQeAy1s=?gv=true" 
          title="Book a meeting with Mulloy"
          loading="lazy"
        ></iframe>
      </div>
      
      <!-- Buy Me a Coffee -->
      <div class="contact__support animate-on-scroll delay-2">
        <div class="support__content">
          <div class="support__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.067 2.017.144l.228.031c.267.04.533.088.798.145.392.085.895.113 1.07.542.055.137.08.288.111.431l.319 1.484a.237.237 0 01-.199.284h-.003c-.037.006-.075.01-.112.015a36.704 36.704 0 01-4.743.295 37.059 37.059 0 01-4.699-.304c-.14-.017-.293-.042-.417-.06-.326-.048-.649-.108-.973-.161-.393-.065-.768-.032-1.123.161-.29.16-.527.404-.675.701-.154.316-.199.66-.267 1-.069.34-.176.707-.135 1.056.087.753.613 1.365 1.37 1.502a39.69 39.69 0 0011.343.376.483.483 0 01.535.53l-.071.697-1.018 9.907c-.041.41-.047.832-.125 1.237-.122.637-.553 1.028-1.182 1.171-.577.131-1.165.2-1.756.205-.656.004-1.31-.025-1.966-.022-.699.004-1.556-.06-2.095-.58-.475-.458-.54-1.174-.605-1.793l-.731-7.013-.322-3.094c-.037-.351-.286-.695-.678-.678-.336.015-.718.3-.678.679l.228 2.185.949 9.112c.147 1.344 1.174 2.068 2.446 2.272.742.12 1.503.144 2.257.156.966.016 1.942.053 2.892-.122 1.408-.258 2.465-1.198 2.616-2.657.34-3.332.683-6.663 1.024-9.995l.215-2.087a.484.484 0 01.39-.426c.402-.078.787-.212 1.074-.518.455-.488.546-1.124.385-1.766zm-1.478.772c-.145.137-.363.201-.578.233-2.416.359-4.866.54-7.308.46-1.748-.06-3.477-.254-5.207-.498-.17-.024-.353-.055-.47-.18-.22-.236-.111-.71-.054-.995.052-.26.152-.609.463-.646.484-.057 1.046.148 1.526.22.577.088 1.156.159 1.737.212 2.48.226 5.002.19 7.472-.14.45-.06.899-.13 1.345-.21.399-.072.84-.206 1.08.206.166.281.188.657.162.974a.544.544 0 01-.169.364z"/>
            </svg>
          </div>
          <div class="support__text">
            <h3 class="support__title">Support My Work</h3>
            <p class="support__description">
              If you've found my projects or content helpful, consider buying me a coffee! 
              Your support helps fuel more open-source work and creative experiments.
            </p>
            <a 
              href="https://buymeacoffee.com/mulloymorrow" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="support__link"
            >
              <span>Buy Me a Coffee</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="support__qr">
          <img 
            src="/bmc_qr.png" 
            alt="QR code for Buy Me a Coffee"
            width="120"
            height="120"
            loading="lazy"
          />
          <span class="qr__label">Scan to support</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg-primary) 100%);
    padding: var(--space-20) 0;
  }
  
  .contact__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  
  .contact__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: var(--space-4);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .contact__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .contact__content {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .contact__intro {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  
  .contact__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);
    border-radius: var(--radius-md);
    color: white;
  }
  
  .contact__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  
  .contact__calendar {
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  
  .contact__calendar iframe {
    width: 100%;
    height: 600px;
    border: 0;
    display: block;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .contact {
      padding: var(--space-12) 0;
    }
    
    .contact__intro {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    
    .contact__calendar iframe {
      height: 500px;
    }
  }
  
  @media (max-width: 480px) {
    .contact__calendar iframe {
      height: 450px;
    }
  }
  
  /* Buy Me a Coffee Support Section */
  .contact__support {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  
  .support__content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    flex: 1;
  }
  
  .support__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #ffdd00 0%, #ff6b6b 100%);
    border-radius: var(--radius-md);
    color: #0d0c22;
  }
  
  .support__text {
    flex: 1;
  }
  
  .support__title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
  }
  
  .support__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-4) 0;
  }
  
  .support__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: linear-gradient(135deg, #ffdd00 0%, #ff6b6b 100%);
    color: #0d0c22;
    font-weight: 600;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  
  .support__link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 221, 0, 0.3);
  }
  
  .support__qr {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  
  .support__qr img {
    border-radius: var(--radius-md);
    background: white;
    padding: 8px;
  }
  
  .qr__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  @media (max-width: 768px) {
    .contact__support {
      flex-direction: column;
      text-align: center;
    }
    
    .support__content {
      flex-direction: column;
      align-items: center;
    }
    
    .support__qr {
      order: -1;
    }
  }
</style>
