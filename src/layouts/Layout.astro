---
import NavFloating from '../components/NavFloating.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  showThemeToggle?: boolean;
}

const { 
  title = "Mulloy Morrow | Founder. Tech Leader. Builder.",
  description = "AI & Machine Learning leader with 15+ years of experience spanning consumer tech, healthcare, legal tech, and environmental applications. Former Spotify ML leader building research-driven systems for hundreds of millions of users. Now founding human-centered AI products.",
  canonicalUrl = Astro.url.href,
  ogType = "website",
  ogImage = "https://mulloymorrow.com/og-home.png",
  showThemeToggle = true
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-K6MZZ5RD');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Mulloy Morrow" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Mulloy Morrow - Founder. Tech Leader. Builder." />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@thismulloy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Mulloy Morrow - Blog" href="/blog/rss.xml" />
    
    <title>{title}</title>
    
    <!-- Slot for additional head content (JSON-LD, etc.) -->
    <slot name="head" />

    <!-- Apply saved theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('site-theme');
          if (saved === 'light') {
            document.documentElement.classList.add('theme-warm');
            window.__themeLocked = true;
          } else if (saved === 'dark') {
            document.documentElement.classList.remove('theme-warm');
            window.__themeLocked = true;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K6MZZ5RD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <!-- Theme Toggle -->
    {showThemeToggle && <ThemeToggle client:load />}

    <!-- Floating Navigation -->
    <NavFloating client:load />
    
    <slot />
    
    <script>
      // Intersection Observer for scroll animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);
      
      document.querySelectorAll('.animate-on-scroll').forEach(el => {
        observer.observe(el);
      });
      
      // Theme transition on scroll
      // Switches from dark theme to warm theme when Personal section (or beyond) comes into view
      const personalSection = document.getElementById('personal');
      
      // Helper function to check if we should be in warm theme
      function checkTheme() {
        if (!personalSection) return;
        if ((window as any).__themeLocked) return;
        const rect = personalSection.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const threshold = viewportHeight * 0.2;
        
        // Warm theme if:
        // 1. Personal section is in viewport, OR
        // 2. Personal section is above viewport (we scrolled past it)
        const inViewport = rect.top < viewportHeight - threshold && rect.bottom > threshold;
        const scrolledPast = rect.bottom <= threshold; // Section is above the viewport
        
        if (inViewport || scrolledPast) {
          document.documentElement.classList.add('theme-warm');
        } else {
          // Section is below viewport - use dark theme
          document.documentElement.classList.remove('theme-warm');
        }
      }
      
      // Initial check based on current scroll position
      checkTheme();
      
      // Also check for direct navigation to warm sections
      const warmSections = ['#personal', '#contact'];
      if (!(window as any).__themeLocked && warmSections.includes(window.location.hash)) {
        document.documentElement.classList.add('theme-warm');
      }
      
      if (personalSection) {
        const themeObserver = new IntersectionObserver((entries) => {
          if ((window as any).__themeLocked) return;
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Entering warm section - switch to warm theme
              document.documentElement.classList.add('theme-warm');
            } else {
              // Check if we're above or below the section
              const rect = entry.boundingClientRect;
              if (rect.top > 0) {
                // Section is below viewport - use dark theme
                document.documentElement.classList.remove('theme-warm');
              }
              // If section is above viewport (scrolled past), keep warm theme
            }
          });
        }, {
          threshold: 0,
          rootMargin: '-20% 0px -20% 0px' // Trigger when section is 20% into viewport
        });
        
        themeObserver.observe(personalSection);
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

